# ─────────────────────────────────────────────────────────────────────
# ATK distribution — environment template
# Copy to .env and fill in. NEVER commit a real key.
# Contract: ATK_ROUTING_INTEGRATION.md §3
# ─────────────────────────────────────────────────────────────────────

# ── Provider selection ───────────────────────────────────────────────
# atk | openai | anthropic | gemini | deepseek | qwen | openrouter | custom
PROVIDER=atk

# ── ATK (default Quick Start path) ───────────────────────────────────
ATK_API_KEY=
ATK_BASE_URL=https://api.aitokenking.com/v1
ATK_MODEL=

# ── Bring your own provider (used when PROVIDER != atk) ──────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

GEMINI_API_KEY=
GEMINI_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Any OpenAI-compatible endpoint
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ── Routing behaviour ────────────────────────────────────────────────
FALLBACK_PROVIDERS=
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120

# ── Cost controls (inactive unless set) ──────────────────────────────
TOKEN_BUDGET_PER_RUN=
COST_BUDGET_USD_PER_RUN=
TRACK_USAGE=true

# ── Attribution (opt-in, disclosed in the README) ────────────────────
# Where you found this. Leave blank to send nothing.
ATK_REFERRAL=
