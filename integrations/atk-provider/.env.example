# ─────────────────────────────────────────────────────────────────────
# ATK provider seam — environment template
# Copy to .env and fill in.  NEVER commit a real key.
# Contract: ATK_ROUTING_INTEGRATION.md §3
# ─────────────────────────────────────────────────────────────────────

# ── Provider selection ───────────────────────────────────────────────
# atk | openai | anthropic | gemini | deepseek | qwen | openrouter | custom
# Changing this switches provider with NO code edit. That is the point.
PROVIDER=atk

# ── ATK (default Quick Start path) ───────────────────────────────────
# NOTE: as of 2026-09-18 `api.aitokenking.com` did not resolve from the build
# environment and no ATK credential was available, so the value below is the
# one the contract document states and is NOT a verified endpoint.
# See VERIFICATION.md before relying on it.
ATK_API_KEY=
ATK_BASE_URL=https://api.aitokenking.com/v1
ATK_MODEL=

# ── Bring your own provider (used when PROVIDER != atk) ──────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Any OpenAI-compatible host: a gateway, a proxy, a local server.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ── Routing behaviour ────────────────────────────────────────────────
# Tried in order after PROVIDER fails. A provider that is not configured is
# skipped, not retried.
FALLBACK_PROVIDERS=
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120
