# ─────────────────────────────────────────────────────────────────────
# ATK provider seam — environment template
# Copy to .env and fill in.  NEVER commit a real key.
# Contract: ATK_ROUTING_INTEGRATION.md §3
# ─────────────────────────────────────────────────────────────────────

# ── Provider selection ───────────────────────────────────────────────
# atk | openai | anthropic | gemini | deepseek | qwen | openrouter | custom
# Changing this switches provider with NO code edit. That is the point.
PROVIDER=atk

# ── ATK (default Quick Start path) ───────────────────────────────────
# Base URL corrected 2026-09-18 (P4-03). The earlier value in this file was
# missing both `.tw` and `/api` and did not resolve. The value below comes from
# the official docs and a reviewer confirmed GET /api/v1/models returns HTTP 200
# with 52 models, and one live chat completion. See VERIFICATION.md.
#   https://aitokenking.com.tw/assets/docs/zh-Hant/index.html#mcp-server
#
# VARIABLE NAMING: the official docs call the key AITOKENKING_API_KEY. This
# repository's contract (ATK_ROUTING_INTEGRATION.md §3) calls it ATK_API_KEY.
# ATK_API_KEY is the name used here; AITOKENKING_API_KEY is accepted as an
# alias so you can paste either. Do not set both to different values.
ATK_API_KEY=
ATK_BASE_URL=https://api.aitokenking.com.tw/api/v1
ATK_MODEL=

# ── ATK MCP server — a DIFFERENT protocol, not a base URL ────────────
# Do NOT put this in ATK_BASE_URL. MCP is not OpenAI chat-completions, and
# this adapter does not speak it. Listed so the two are not confused.
#   endpoint: https://api.aitokenking.com.tw/mcp
#   header:   X-Aitokenking-Api-Key: <your key>
# See README § "ATK MCP" for a client config that uses it directly.

# ── Bring your own provider (used when PROVIDER != atk) ──────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=

ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
ANTHROPIC_MODEL=

DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=

QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=

# Any OpenAI-compatible host: a gateway, a proxy, a local server.
CUSTOM_API_KEY=
CUSTOM_BASE_URL=
CUSTOM_MODEL=

# ── Routing behaviour ────────────────────────────────────────────────
# Tried in order after PROVIDER fails. A provider that is not configured is
# skipped, not retried.
FALLBACK_PROVIDERS=
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=120

# ── Diagnostics ──────────────────────────────────────────────────────
# Off by default. A provider's error body can echo the credential it just
# rejected (P4-01), so it is withheld unless you ask for it. Known keys are
# redacted either way, but redaction only catches values it knows.
ATK_INCLUDE_ERROR_BODY=0
