  "applicability": {
    "use_when": [
      "Agent 準備在工作流程中引用一個知識包",
      "Agent 收到撤回或版本事件"
    ],
    "not_for": [
      "自動抓取最新版本取代已釘死的版本",
      "在狀態不明時繼續使用治理類規則"
    ],
    "prerequisites": [
      "已釘死版本",
      "有可查詢的狀態端點"
    ],
    "compatible_versions": [
      "MCP 2026-07-28"
    ],
    "jurisdiction_if_relevant": null
  },
  "method": {
    "steps": [
      "查 valid_until：已過期則停止引用。",
      "查 status 端點：retracted 或 superseded 則停止並取得替代版本。",
      "比對 content_hash 與釘死版本：不符即停止，不得就地採用。",
      "狀態端點取不到時，依 risk_class 決定：governance 一律停止。",
      "留存本次引用的 package_id、version 與判定結果。"
    ],
    "decision_rules": [
      {
        "rule_id": "R-001",
        "when": "valid_until 早於今天",
        "then": "停止引用，回退到上一個已核准版本，不得自動抓最新",
        "claim_refs": [
          "C-004"
        ]
      },
      {
        "rule_id": "R-002",
        "when": "狀態端點回傳 retracted",
        "then": "立即停止並依 revoked_by／superseded_by 取得替代版本；舊版本不得就地改寫消滅錯誤",
        "claim_refs": [
          "C-003",
          "C-004"
        ]
      },
      {
        "rule_id": "R-003",
        "when": "狀態端點無法取得且 risk_class 為 governance",
        "then": "fail closed，停止引用",
        "claim_refs": [
          "C-001"
        ]
      },
      {
        "rule_id": "R-004",
        "when": "實際內容的 hash 與紀錄上的識別碼不符",
        "then": "停止並回報；自填而無驗證的識別碼不算證據",
        "claim_refs": [
          "C-001"
        ]
      },
      {
        "rule_id": "R-005",
        "when": "同一份來源的不同段落對同一狀態給出不同答案",
        "then": "回 NEEDS_INFORMATION，不挑一段當結論",
        "claim_refs": [
          "C-005"
        ]
      },
      {
        "rule_id": "R-006",
        "when": "工具清單帶 ttlMs 已逾時，或句柄回傳過期錯誤",
        "then": "重新取得清單或重建句柄，不沿用舊快取",
        "claim_refs": [
          "C-006"
        ]
      }
    ],
    "required_approvals": [
      "客戶管理者核准採用並釘死版本"
    ],
    "escalation_conditions": [
      "狀態端點無法取得",
      "hash 不符",
      "同一來源自相矛盾",
      "撤回後找不到替代版本"
    ],
    "rollback": "停止引用本包，回退至上一個已核准版本，保留本次判定紀錄；撤回不保證能刪除客戶已另存的副本。"
  },
